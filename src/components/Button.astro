---
import { WHATSAPP_HREF } from '../data/site.ts';

interface Props {
  variant?: 'primary' | 'secondary' | 'secondary-dark';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  openCita?: boolean;
}
const { variant = 'primary', href, type = 'button', class: cls = '', openCita = false } = Astro.props;
const classes =
  variant === 'primary' ? `btn-primary ${cls}` : variant === 'secondary-dark' ? `btn-secondary btn-secondary--on-dark ${cls}` : `btn-secondary ${cls}`;
---
{
  href ? (
    <a href={href} class={classes}>
      <slot />
    </a>
  ) : openCita ? (
    <a href={WHATSAPP_HREF} class={classes}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes}>
      <slot />
    </button>
  )
}
