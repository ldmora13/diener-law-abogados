---
import { ui, type Lang } from '../data/i18n.ts';
import { WHATSAPP_HREF, FACEBOOK_URL, INSTAGRAM_URL } from '../data/site.ts';

interface Props {
  lang?: Lang;
  serviceBase?: string;
}
const { lang = 'es', serviceBase = '/servicios' } = Astro.props;
const t = ui[lang].footer;
const servicios = [
  { slug: 'visas-familiares', titulo: lang === 'es' ? 'Visas familiares' : 'Family visas' },
  { slug: 'visas-trabajo', titulo: lang === 'es' ? 'Visas de trabajo' : 'Work visas' },
  { slug: 'visas-estudiante', titulo: lang === 'es' ? 'Visas de estudiante' : 'Student visas' },
  { slug: 'ciudadania-green-card', titulo: lang === 'es' ? 'Ciudadanía y Green Card' : 'Citizenship & Green Card' },
  { slug: 'defensa-deportacion', titulo: lang === 'es' ? 'Defensa de deportación' : 'Deportation defense' },
];
const oficinas = [
  { estado: lang === 'es' ? 'Carolina del Norte' : 'North Carolina', dir: 'Greenville, NC', tel: '(252) 747-7400' },
  { estado: lang === 'es' ? 'California' : 'California', dir: 'Santa Ana, CA', tel: '(949) 649-6378' },
  { estado: lang === 'es' ? 'Arizona' : 'Arizona', dir: 'Phoenix, AZ', tel: '(602) 838-6665' },
  { estado: lang === 'es' ? 'Texas' : 'Texas', dir: 'Dallas, TX', tel: '(469) 218-2269' },
];
---
<footer class="bg-night-deep text-paper">
  <div class="mx-auto max-w-[1200px] px-6 py-16 grid gap-10 md:grid-cols-2 lg:grid-cols-4">
    <div>
      <img src='/logo-white.webp' alt="Diener Law Abogados" class="h-8" />
      <p class="font-body text-[16px] leading-[1.6] text-paper/80 mt-4">{t.tagline}</p>
      <div class="flex flex-row justify-start mt-5 gap-5">
        <a href="https://wa.me/18632271367" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="inline-block">
          <svg viewBox="0 0 24 24" fill="none" width="36px" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> 
            <path d="M6.014 8.00613C6.12827 7.1024 7.30277 5.87414 8.23488 6.01043L8.23339 6.00894C9.14051 6.18132 9.85859 7.74261 10.2635 8.44465C10.5504 8.95402 10.3641 9.4701 10.0965 9.68787C9.7355 9.97883 9.17099 10.3803 9.28943 10.7834C9.5 11.5 12 14 13.2296 14.7107C13.695 14.9797 14.0325 14.2702 14.3207 13.9067C14.5301 13.6271 15.0466 13.46 15.5548 13.736C16.3138 14.178 17.0288 14.6917 17.69 15.27C18.0202 15.546 18.0977 15.9539 17.8689 16.385C17.4659 17.1443 16.3003 18.1456 15.4542 17.9421C13.9764 17.5868 8 15.27 6.08033 8.55801C5.97237 8.24048 5.99955 8.12044 6.014 8.00613Z" fill="#ffffff"></path> <path fill-rule="evenodd" clip-rule="evenodd" d="M12 23C10.7764 23 10.0994 22.8687 9 22.5L6.89443 23.5528C5.56462 24.2177 4 23.2507 4 21.7639V19.5C1.84655 17.492 1 15.1767 1 12C1 5.92487 5.92487 1 12 1C18.0751 1 23 5.92487 23 12C23 18.0751 18.0751 23 12 23ZM6 18.6303L5.36395 18.0372C3.69087 16.4772 3 14.7331 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12C21 16.9706 16.9706 21 12 21C11.0143 21 10.552 20.911 9.63595 20.6038L8.84847 20.3397L6 21.7639V18.6303Z" fill="#ffffff"></path> </g>
          </svg>
        </a>
        <a href={FACEBOOK_URL} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="inline-block">
          <svg fill="#ffffff" width="16px" version="1.1" id="Layer_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="-337 273 123.5 256" xml:space="preserve" stroke="#ffffff"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> 
            <path d="M-260.9,327.8c0-10.3,9.2-14,19.5-14c10.3,0,21.3,3.2,21.3,3.2l6.6-39.2c0,0-14-4.8-47.4-4.8c-20.5,0-32.4,7.8-41.1,19.3 c-8.2,10.9-8.5,28.4-8.5,39.7v25.7H-337V396h26.5v133h49.6V396h39.3l2.9-38.3h-42.2V327.8z"></path> </g>
          </svg>
        </a>
        <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="inline-block">
          <svg viewBox="0 0 20 20" version="1.1" height="32px" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" fill="#000000" stroke="#000000"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <defs> </defs> <g id="Page-1" stroke="none" stroke-width="1" fill="none" fill-rule="evenodd"> <g id="Dribbble-Light-Preview" transform="translate(-340.000000, -7439.000000)" fill="#ffffff"> <g id="icons" transform="translate(56.000000, 160.000000)"> 
            <path d="M289.869652,7279.12273 C288.241769,7279.19618 286.830805,7279.5942 285.691486,7280.72871 C284.548187,7281.86918 284.155147,7283.28558 284.081514,7284.89653 C284.035742,7285.90201 283.768077,7293.49818 284.544207,7295.49028 C285.067597,7296.83422 286.098457,7297.86749 287.454694,7298.39256 C288.087538,7298.63872 288.809936,7298.80547 289.869652,7298.85411 C298.730467,7299.25511 302.015089,7299.03674 303.400182,7295.49028 C303.645956,7294.859 303.815113,7294.1374 303.86188,7293.08031 C304.26686,7284.19677 303.796207,7282.27117 302.251908,7280.72871 C301.027016,7279.50685 299.5862,7278.67508 289.869652,7279.12273 M289.951245,7297.06748 C288.981083,7297.0238 288.454707,7296.86201 288.103459,7296.72603 C287.219865,7296.3826 286.556174,7295.72155 286.214876,7294.84312 C285.623823,7293.32944 285.819846,7286.14023 285.872583,7284.97693 C285.924325,7283.83745 286.155174,7282.79624 286.959165,7281.99226 C287.954203,7280.99968 289.239792,7280.51332 297.993144,7280.90837 C299.135448,7280.95998 300.179243,7281.19026 300.985224,7281.99226 C301.980262,7282.98483 302.473801,7284.28014 302.071806,7292.99991 C302.028024,7293.96767 301.865833,7294.49274 301.729513,7294.84312 C300.829003,7297.15085 298.757333,7297.47145 289.951245,7297.06748 M298.089663,7283.68956 C298.089663,7284.34665 298.623998,7284.88065 299.283709,7284.88065 C299.943419,7284.88065 300.47875,7284.34665 300.47875,7283.68956 C300.47875,7283.03248 299.943419,7282.49847 299.283709,7282.49847 C298.623998,7282.49847 298.089663,7283.03248 298.089663,7283.68956 M288.862673,7288.98792 C288.862673,7291.80286 291.150266,7294.08479 293.972194,7294.08479 C296.794123,7294.08479 299.081716,7291.80286 299.081716,7288.98792 C299.081716,7286.17298 296.794123,7283.89205 293.972194,7283.89205 C291.150266,7283.89205 288.862673,7286.17298 288.862673,7288.98792 M290.655732,7288.98792 C290.655732,7287.16159 292.140329,7285.67967 293.972194,7285.67967 C295.80406,7285.67967 297.288657,7287.16159 297.288657,7288.98792 C297.288657,7290.81525 295.80406,7292.29716 293.972194,7292.29716 C292.140329,7292.29716 290.655732,7290.81525 290.655732,7288.98792" id="instagram-[#00d5ff]"> </path> </g> </g> </g> </g>
          </svg>
        </a>
      </div>
    </div>
    <nav aria-label={t.services}>
      <p class="font-heading text-[18px] text-verdict-gold uppercase">{t.services}</p>
      <ul class="mt-4 space-y-1 font-body text-[16px] text-paper/80">
        {servicios.map((s) => (
          <li><a class="min-h-[44px] inline-flex items-center underline-offset-4 hover:underline" href={`${serviceBase}/${s.slug}`}>{s.titulo}</a></li>
        ))}
      </ul>
    </nav>
    <div>
      <p class="font-heading text-[18px] text-verdict-gold uppercase">{t.offices}</p>
      <ul class="mt-4 space-y-3 font-body text-[16px] text-paper/80">
        {oficinas.map((o) => (
          <li><strong class="text-paper">{o.estado}</strong><br />{o.dir}<br /></li>
        ))}
      </ul>
    </div>
    <div>
      <p class="font-heading text-[18px] text-verdict-gold uppercase">{t.contact}</p>
       <a href={WHATSAPP_HREF}>+1 (863) 227-1367</a>
      <p class="mt-4 font-body text-[16px] text-paper/80">{t.contactText}<br />{lang === 'es' ? 'Lun–Vie 9:00–18:00' : 'Mon–Fri 9:00 AM–6:00 PM'}</p>
      <a href={WHATSAPP_HREF} class="link-arrow !text-verdict-gold mt-4 inline-block">{t.schedule} <span aria-hidden="true">→</span></a>
    </div>
  </div>
  <p class="text-center text-xs text-paper/80 pb-5">© 2026 Diener Law, PA. All rights reserved. DIENER LAW™ is a service mark of Diener Law, PA. <a href={lang === 'es' ? '/privacidad' : '/en/privacy'} class="underline underline-offset-4">{t.privacyLink}</a></p>
  <div class="h-16 lg:hidden" aria-hidden="true"></div>
  
</footer>
