---
import { Image } from 'astro:assets';
import heroImg from '../assets/CALIFORNIA-NORTH-CAROLINA-IMMIGRATION-ATTORNEYS-1024x821.webp';
import Button from './Button.astro';
import { ui, type Lang } from '../data/i18n.ts';

interface Props {
  lang?: Lang;
}
const { lang = 'es' } = Astro.props;
const t = ui[lang].hero;
const callNow = ui[lang].callNow;
---
<section id="inicio" class="relative min-h-[calc(100dvh-4rem)] overflow-hidden bg-counsel-navy lg:min-h-[calc(100dvh-5rem)]">
  <div data-hero-media aria-hidden="true" class="absolute -bottom-10 right-0 z-10 hidden w-[52%] max-w-[680px] lg:right-[3%] lg:block">
    <Image
      src={heroImg}
      alt=""
      data-hero-bg
      widths={[768, 1024, 1440]}
      sizes="(min-width: 1024px) 52vw, 100vw"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="h-auto w-full object-contain object-bottom will-change-transform"
    />
  </div>
  <div aria-hidden="true" class="absolute inset-0 z-0" style="background: linear-gradient(90deg, rgba(31,52,97,0.98) 0%, rgba(31,52,97,0.94) 52%, rgba(31,52,97,0.68) 100%)"></div>
  <div data-hero-parallax class="relative z-20 mx-auto flex min-h-[calc(100dvh-4rem)] max-w-[1200px] flex-col items-center justify-center gap-y-5 px-6 py-16 text-center md:py-20 lg:min-h-[calc(100dvh-5rem)] lg:items-start lg:pr-[40%] lg:text-left">
    <p data-hero class="font-body text-[13px] font-bold uppercase tracking-[0.08em] leading-[1.2] text-verdict-gold">{t.eyebrow}</p>
    <h1 data-hero class="font-heading font-bold text-paper text-[32px] leading-[1.1] md:text-[40px] lg:text-[56px] max-w-[20ch]">
      {t.title}
    </h1>
    <p data-hero class="font-heading font-medium text-paper text-[20px] md:text-[24px] mt-4">{t.subtitle}</p>
    <p data-hero class="font-body text-[16px] leading-[1.6] text-paper mt-6 max-w-[760px] lg:max-w-[600px]">
      {t.para}
    </p>
    <div data-hero class="mt-8 flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
      <Button openCita>{t.cta}</Button>
    </div>
    <p data-hero class="font-body text-[13px] text-paper/80 mt-4">{t.note}</p>
  </div>
</section>
