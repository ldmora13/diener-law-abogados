---
interface Props {
  size?: 64 | 80;
  variant?: 'default' | 'inverted' | 'gold';
  label?: string;
}
const { size = 64, variant = 'default', label } = Astro.props;
const dim = size === 80 ? 'w-20 h-20' : 'w-16 h-16';
const border =
  variant === 'inverted'
    ? 'border-paper text-paper'
    : variant === 'gold'
      ? 'border-verdict-gold text-verdict-gold'
      : 'border-authority-blue text-authority-blue';
---
<div
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  class={`rounded-full border-2 ${dim} ${border} inline-flex items-center justify-center shrink-0 transition-[transform,background-color,border-color] duration-200 ease-out group-hover:-translate-y-0.5 group-hover:bg-sky-mist [&>svg]:w-8 [&>svg]:h-8 [&>svg]:stroke-[2px]`}
>
  <slot />
</div>
