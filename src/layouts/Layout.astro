---
import '../index.css';
import LangTransition from '../components/LangTransition.astro';
import CitaModal from '../components/CitaModal.tsx';
import Seo from '../components/Seo.astro';
import { ui, type Lang } from '../data/i18n.ts';
import { attorneySchema, websiteSchema } from '../data/schemas.ts';
import { WHATSAPP_HREF } from '../data/site.ts';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  path?: string;
  altEs?: string;
  altEn?: string;
  schemas?: unknown[];
  noindex?: boolean;
}

const {
  title = 'Diener Law Abogados — Abogados de inmigración en NC, CA, AZ y TX',
  description = 'Despacho de abogados de inmigración. Visas familiares, de trabajo, de estudiante, ciudadanía, green card y defensa de deportación. Consulta confidencial en español.',
  lang = 'es',
  path = '/',
  altEs = '/',
  altEn = '/en/',
  schemas = [],
  noindex = false,
} = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/webp" href="/favicon.webp" />
    <Seo title={title} description={description} lang={lang} path={path} altEs={altEs} altEn={altEn} schemas={[attorneySchema(), websiteSchema(lang), ...schemas]} noindex={noindex} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Open+Sans:wght@400;600;700&family=Libre+Baskerville:ital@0;1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-paper text-slate-ink font-body antialiased">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[100] focus:bg-verdict-gold focus:text-counsel-navy focus:px-4 focus:py-2"
    >
      {ui[lang].skip}
    </a>
    <slot name="header" />
    <div id="scroll-progress" aria-hidden="true" class="fixed top-0 left-0 h-[3px] w-full bg-verdict-gold origin-left scale-x-0 z-[60]"></div>
    <main id="contenido">
      <slot />
    </main>
    <slot name="footer" />
    <CitaModal client:load lang={lang} />
    <noscript>
      <div style="background:#1f3461;color:#fff;text-align:center;padding:16px;font-family:sans-serif">
        {ui[lang].form.noscript} <a style="color:#fdd04b" href={WHATSAPP_HREF}>+1 (863) 227-1367</a>
      </div>
    </noscript>
    <LangTransition label={lang === 'es' ? 'EN' : 'ES'} />
    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
