---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Button from '../../components/Button.astro';
import IconCircle from '../../components/IconCircle.astro';
import AppointmentForm from '../../components/AppointmentForm.tsx';
import ChatWidget from '../../components/ChatWidget.tsx';
import { detalleServicios } from '../../data/detalle-servicios.ts';
import { faqSchema, breadcrumbSchema } from '../../data/schemas.ts';

export function getStaticPaths() {
  return detalleServicios.map((s) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const servicio = detalleServicios.find((s) => s.slug === slug);
if (!servicio) throw new Error(`Servicio no encontrado: ${slug}`);
---

<Layout
  title={`${servicio.titulo} — Diener Law Abogados`}
  description={servicio.resumen}
  path={`/servicios/${servicio.slug}`}
  altEs={`/servicios/${servicio.slug}`}
  altEn={`/en/services/${servicio.slug}`}
  schemas={[
    faqSchema(servicio.faqs.map((f) => ({ pregunta: f.pregunta, respuesta: f.respuesta }))),
    breadcrumbSchema([
      { name: 'Inicio', path: '/' },
      { name: servicio.titulo, path: `/servicios/${servicio.slug}` },
    ]),
  ]}
>
  <Header slot="header" base="/" switchHref={`/en/services/${servicio.slug}`} />
  <Footer slot="footer" />

  {/* Héroe interno */}
  <section class="bg-counsel-navy">
    <div data-hero-parallax class="mx-auto max-w-[1200px] px-6 py-16 text-center">
      <div class="flex justify-center mb-6">
        <IconCircle size={80} variant="gold" label={servicio.titulo}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v4l2 2"/></svg>
        </IconCircle>
      </div>
      <p class="font-body text-[13px] font-bold uppercase tracking-[0.08em] text-verdict-gold">Consulta gratuita · Español e inglés</p>
      <h1 class="font-heading font-bold text-[32px] md:text-[40px] text-paper mt-3">{servicio.titulo}</h1>
      <p class="font-body text-[16px] leading-[1.6] text-paper mx-auto max-w-[760px] mt-4">{servicio.resumen}</p>
      <div class="mt-8"><Button href="#cita-servicio">Agenda tu consulta</Button></div>
    </div>
  </section>

  <div class="mx-auto max-w-[1200px] px-6 py-16 grid gap-12 lg:grid-cols-[260px_1fr]">
    {/* Nav lateral */}
    <aside class="hidden lg:block">
      <nav aria-label="En esta página" class="sticky top-28 border-l border-mist">
        {[
          ['#para-quien', 'Para quién es'],
          ['#requisitos', 'Requisitos'],
          ['#proceso', 'Proceso'],
          ['#plazos', 'Plazos y costos'],
          ['#faq-servicio', 'Preguntas'],
        ].map(([href, label]) => (
          <a href={href} class="block px-4 py-3 min-h-[44px] font-body text-[14px] font-semibold text-quiet-slate border-l-[3px] border-transparent hover:border-verdict-gold hover:text-authority-blue">{label}</a>
        ))}
        <p class="px-4 pt-4 font-body text-[13px] text-quiet-slate">Otras áreas:</p>
        {detalleServicios.filter((s) => s.slug !== servicio.slug).map((s) => (
          <a href={`/servicios/${s.slug}`} class="block px-4 py-2 min-h-[44px] font-body text-[14px] text-authority-blue underline underline-offset-4">{s.titulo}</a>
        ))}
      </nav>
    </aside>

    <div class="max-w-[760px]">
      <nav aria-label="Migas de pan" class="mb-6 font-body text-[14px] text-quiet-slate">
        <a href="/" class="underline underline-offset-4">Inicio</a> <span aria-hidden="true">›</span> <span aria-current="page" class="text-authority-blue font-semibold">{servicio.titulo}</span>
      </nav>
      {/* En breve */}
      <div data-reveal class="bg-sky-mist border-l-4 border-authority-blue rounded-[4px] p-6" role="note" aria-label="Resumen del servicio">
        <p class="font-heading text-[20px] uppercase text-authority-blue">En breve</p>
        <ul class="mt-3 space-y-2 font-body text-[16px] leading-[1.6]">
          <li><strong>Quién califica:</strong> {servicio.paraQuien[0]}.</li>
          <li><strong>Tiempo estimado:</strong> {servicio.plazos}</li>
          <li><strong>Paso inicial:</strong> {servicio.proceso[0].titulo} — {servicio.proceso[0].desc}</li>
        </ul>
      </div>

      <h2 id="para-quien" class="font-heading font-semibold text-[30px] text-authority-blue mt-12 scroll-mt-28">Para quién es</h2>
      <ul class="mt-4 space-y-2 font-body text-[16px] leading-[1.6]">
        {servicio.paraQuien.map((p) => (<li class="flex gap-2"><span aria-hidden="true" class="text-approved-green font-bold">✓</span>{p}</li>))}
      </ul>

      <h2 id="requisitos" class="font-heading font-semibold text-[30px] text-authority-blue mt-12 scroll-mt-28">Requisitos</h2>
      <ul class="mt-4 space-y-2 font-body text-[16px] leading-[1.6]">
        {servicio.requisitos.map((r) => (<li class="flex gap-2"><span aria-hidden="true" class="text-authority-blue">•</span>{r}</li>))}
      </ul>

      <h2 id="proceso" class="font-heading font-semibold text-[30px] text-authority-blue mt-12 scroll-mt-28">Proceso</h2>
      <ol class="mt-4 space-y-6">
        {servicio.proceso.map((p, i) => (
          <li class="flex gap-4">
            <span aria-hidden="true" class="w-12 h-12 rounded-full bg-authority-blue text-paper font-heading text-[20px] inline-flex items-center justify-center shrink-0">{i + 1}</span>
            <div><h3 class="font-heading text-[20px] text-authority-blue">{p.titulo}</h3><p class="font-body text-[16px] leading-[1.6]">{p.desc}</p></div>
          </li>
        ))}
      </ol>

      <h2 id="plazos" class="font-heading font-semibold text-[30px] text-authority-blue mt-12 scroll-mt-28">Plazos y costos orientativos</h2>
      <p class="font-body text-[16px] leading-[1.6] mt-4"><strong>Plazos:</strong> {servicio.plazos}</p>
      <p class="font-body text-[16px] leading-[1.6] mt-2"><strong>Costos:</strong> {servicio.costos}</p>

      <h2 id="faq-servicio" class="font-heading font-semibold text-[30px] text-authority-blue mt-12 scroll-mt-28">Preguntas frecuentes</h2>
      <div class="mt-4">
        {servicio.faqs.map((f) => (
          <details class="border-b border-mist py-4">
            <summary class="font-body text-[18px] font-semibold text-authority-blue cursor-pointer min-h-[44px]">{f.pregunta}</summary>
            <p class="font-body text-[16px] leading-[1.6] mt-2">{f.respuesta}</p>
          </details>
        ))}
      </div>

      <div data-reveal class="bg-parchment border border-mist rounded-[4px] p-8 mt-12 text-center">
        <h2 class="font-heading text-[24px] text-authority-blue">¿Es este tu caso? Hablemos.</h2>
        <p class="font-body text-[16px] mt-2">Consulta confidencial en español. Sin compromiso.</p>
        <div class="mt-6"><Button href="#cita-servicio">Solicitar consulta</Button></div>
        <p class="font-body text-[13px] text-quiet-slate mt-4">Publicidad de abogados. Los resultados varían según cada caso.</p>
      </div>
    </div>
  </div>

  {/* Formulario final */}
  <section id="cita-servicio" class="bg-justice-blue scroll-mt-20">
    <div class="mx-auto max-w-[760px] px-6 py-16">
      <h2 class="font-heading font-semibold text-[30px] text-paper text-center">Agenda tu consulta de {servicio.titulo.toLowerCase()}</h2>
      <div class="bg-paper border border-mist rounded-[4px] p-6 md:p-10 mt-8">
        <AppointmentForm client:visible />
      </div>
    </div>
  </section>

  <ChatWidget client:visible />
</Layout>
